// Regras de segurança do Firestore para o HubPG.
//
// Como usar: no Firebase, vá em Firestore Database > Regras, apague o que
// estiver lá, cole TUDO abaixo e clique em Publicar. Não precisa trocar nada.
//
// O que elas fazem:
//  - qualquer pessoa pode LER as campanhas (o site é público);
//  - qualquer pessoa que tenha entrado no admin (conta criada ou Google)
//    pode criar, editar ou apagar campanhas;
//  - todo o resto do banco fica trancado.
//
// Para deixar só você editando, desative o cadastro de novas contas
// (Authentication > Settings > User actions) depois de criar a sua, ou
// peça para restringir por conta.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /campanhas/{campanha} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
